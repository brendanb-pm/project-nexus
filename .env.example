# Public application URL; never place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only OIDC and session configuration. Never use NEXT_PUBLIC_* for these.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
OIDC_ISSUER=https://identity.example.invalid
OIDC_DISCOVERY_URL=https://identity.example.invalid/.well-known/openid-configuration
OIDC_CLIENT_ID=project-nexus
OIDC_CLIENT_SECRET=replace-with-provider-client-secret
DATABASE_URL=postgresql://nexus_app:nexus_local_only@localhost:5434/nexus_demo

# Localhost-only development persona sign-in. Never enable outside local development.
NEXUS_DEV_AUTH=false

# Development/non-production only. Emits aggregate timing and query-count events.
NEXUS_PERFORMANCE_TELEMETRY=false
